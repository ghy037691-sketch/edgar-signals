{
  "title": "SEC EDGAR Signals",
  "type": "object",
  "schemaVersion": 1,
  "properties": {
    "action": {
      "title": "Action",
      "type": "string",
      "enum": ["snapshot", "funding_leads", "insider_transactions", "filing_search"],
      "default": "funding_leads",
      "editor": "select",
      "description": "funding_leads = newest Form D filings (sales leads: companies that just raised); insider_transactions = Form 4 director/officer buys & sells; snapshot = company profile + financials + recent filings; filing_search = full-text search across filings."
    },
    "symbol": {
      "title": "Ticker or CIK (for snapshot / insider)",
      "type": "string",
      "description": "e.g. NVDA, AAPL, TSLA, or a 10-digit CIK",
      "prefill": "NVDA"
    },
    "keyword": {
      "title": "Keyword (filing_search / optional Form D filter)",
      "type": "string",
      "description": "e.g. 'cybersecurity', 'artificial intelligence', 'bankruptcy'",
      "prefill": "artificial intelligence"
    },
    "forms": {
      "title": "Filing forms (filing_search)",
      "type": "array",
      "items": {"type": "string"},
      "description": "e.g. ['10-K'], ['10-Q'], ['8-K']",
      "default": ["10-K"]
    },
    "days_back": {
      "title": "Days back",
      "type": "integer",
      "minimum": 1,
      "maximum": 3650,
      "default": 30
    },
    "limit": {
      "title": "Max results",
      "type": "integer",
      "minimum": 1,
      "maximum": 500,
      "default": 50
    }
  },
  "required": ["action"]
}
